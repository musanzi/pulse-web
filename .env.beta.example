# Local defaults use the reserved .localhost domain and plain HTTP.
# For a hosted beta, use real hostnames and omit "http://" from the addresses
# so Caddy provisions HTTPS certificates automatically.
WEBSITE_ADDRESS=http://app.localhost
WEBSITE_HOST=app.localhost
ADMIN_ADDRESS=http://admin.localhost
ADMIN_HOST=admin.localhost
ADMIN_ORIGIN=http://admin.localhost
API_UPSTREAM=host.docker.internal:8000
# Replace this value before deploying on a shared or public host.
BETA_ADMIN_TOKEN=replace-with-a-long-random-value
HTTP_PORT=80
HTTPS_PORT=443
